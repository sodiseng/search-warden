# search-warden: settings for docker compose
#
# Copy this file to .env (git-ignored) and edit it. Only WARDEN_ADMIN_PASSWORD
# has to be set; every other line shows the default and is commented out.
# To change one, remove the leading "# " and edit the value.
#
# Keep comments on their own lines. Docker Compose reads `NAME=   # text` (an
# empty value followed by a comment) as the value "# text".

# =============================================================================
# Required
# =============================================================================

# Password of the admin panel user "admin", at least 12 characters.
# It is read only while data/config.yaml has no admin password yet (normally:
# the first start) and stored there as a hash. After logging in you can change
# it in the panel and delete it from this file.
WARDEN_ADMIN_PASSWORD=

# =============================================================================
# Optional: the defaults work as they are
# =============================================================================

# ---- Image ------------------------------------------------------------------
# Image name and tag. `docker compose up -d --build` builds from this repository
# and tags the result with this name; without --build, Compose pulls it.
# WARDEN_IMAGE=ghcr.io/sodiseng/search-warden
# WARDEN_VERSION=latest

# ---- Container user -----------------------------------------------------------
# Owner of the files in ./data. Use your own `id -u` / `id -g` to edit them
# without sudo; otherwise run `sudo chown -R 65532:65532 data` once.
# WARDEN_UID=65532
# WARDEN_GID=65532

# ---- Ports --------------------------------------------------------------------
# Host address and port of the gateway. The admin panel is on the same port,
# under /admin/. Behind a reverse proxy on the same host, bind to 127.0.0.1 so
# the port cannot be reached directly from outside.
# WARDEN_GATEWAY_BIND=0.0.0.0
# WARDEN_GATEWAY_PORT=18683

# ---- Admin panel ----------------------------------------------------------------
# By default the panel shares the gateway port ("shared"), so the service uses
# one port only. A separate panel port is OFF BY DEFAULT. To turn it on, set
# WARDEN_ADMIN_LISTEN=:18684 and uncomment the second port mapping in
# docker-compose.yml. WARDEN_ADMIN_BIND / WARDEN_ADMIN_PORT are the host side of
# that port and do nothing while it is off.
# WARDEN_ADMIN_LISTEN=shared
# WARDEN_ADMIN_BIND=127.0.0.1
# WARDEN_ADMIN_PORT=18684
# Path the panel is mounted at. It must not be "/" while the panel shares the
# gateway port.
# WARDEN_ADMIN_BASE_PATH=/admin/

# ---- Behind a reverse proxy -------------------------------------------------------
# Public address of the gateway. Only used in the client configuration examples
# the panel shows.
# WARDEN_PUBLIC_URL=https://gw.example.com
# Public address of the panel (the same host when the panel shares the port).
# Logins and changes are accepted only from this origin.
# WARDEN_ADMIN_PUBLIC_URL=https://gw.example.com
# Set to true when the panel is reached over HTTPS. Keep false on plain HTTP:
# browsers do not send a Secure cookie over HTTP, so logging in would fail.
# WARDEN_COOKIE_SECURE=false

# ---- Database ---------------------------------------------------------------------
# SQLite is the default and needs no setup: the files live in ./data/db.
# WARDEN_DB=sqlite:///data/db
# PostgreSQL instead: set both lines below (same password in both) and start
# with `docker compose --profile postgres up -d --build`.
# PG_PASSWORD=change-me
# WARDEN_DB=postgres://warden:change-me@postgres:5432/warden?sslmode=disable

# ---- Prometheus metrics -------------------------------------------------------------
# Setting a token (at least 16 characters, no spaces) enables GET /metrics,
# read with the header `Authorization: Bearer <token>`. Empty = disabled.
# WARDEN_METRICS_TOKEN=

# ---- Logging ----------------------------------------------------------------------
# Level: debug | info | warn | error. Format: json | text.
# WARDEN_LOG_LEVEL=info
# WARDEN_LOG_FORMAT=json
